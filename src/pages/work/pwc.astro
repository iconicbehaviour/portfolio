---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const highlights = [
	{ label: 'Company', value: 'PwC' },
	{ label: 'Period', value: 'September - December 2025' },
	{ label: 'Role', value: 'Product Manager' },
];

const outcomes = [
	'Delivered critical features on compressed timeline for executive stakeholders',
	'Defined success metrics that improved product-market fit',
	'Established user research practices for data-driven decisions',
];
---

<Layout
	title="PwC Case Study | Niranjana - Product Manager"
	description="Product case study showcasing enterprise product management at PwC"
	ogType="article"
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<main id="main-content" class="case-main">
			<header class="case-header">
				<a href="/work" class="back-link">← Back to work</a>
				<h1>PwC</h1>
				<p class="case-subtitle">Building enterprise solutions for financial services</p>
			</header>

			<section class="case-meta">
				<div class="meta-grid">
					{highlights.map((highlight) => (
						<div class="meta-item">
							<p class="meta-label">{highlight.label}</p>
							<p class="meta-value">{highlight.value}</p>
						</div>
					))}
				</div>
			</section>

			<section class="case-section">
				<h2>Overview</h2>
				<p>
					At PwC, I managed product development for enterprise-facing tools used by financial professionals.
					Working on a compressed timeline, I prioritized features that addressed user pain points while
					maintaining alignment with business objectives.
				</p>
			</section>

			<section class="case-section">
				<h2>Challenge</h2>
				<p>
					The core challenge was shipping high-impact features on a tight timeline for enterprise clients
					with complex requirements. This required strong prioritization, clear communication with
					stakeholders, and collaborative problem-solving with design and engineering teams.
				</p>
			</section>

			<section class="case-section">
				<h2>Approach</h2>
				<ul>
					<li>Conducted stakeholder interviews to understand critical business needs</li>
					<li>Prioritized features based on impact and feasibility</li>
					<li>Established regular communication cadence with engineering and design</li>
					<li>Defined clear success criteria and tracking mechanisms</li>
					<li>Iterated based on user feedback and performance data</li>
				</ul>
			</section>

			<section class="case-section">
				<h2>Outcomes</h2>
				<ul>
					{outcomes.map((outcome) => (
						<li>{outcome}</li>
					))}
				</ul>
			</section>

			<section class="case-section">
				<h2>Key Learnings</h2>
				<p>
					This experience taught me the value of ruthless prioritization and clear communication under
					pressure. In enterprise environments, understanding stakeholder needs and building trust across
					teams is as important as the product itself.
				</p>
			</section>

			<footer class="case-footer">
				<a href="/work" class="back-link">← Back to work</a>
			</footer>
		</main>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.case-header {
		padding: 4rem 0 3rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 3rem;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--muted-foreground);
		text-decoration: none;
		font-size: 0.95rem;
		transition: color 150ms ease;
	}

	.back-link:hover {
		color: var(--foreground);
	}

	.case-header h1 {
		font-size: 2.5rem;
		margin: 0;
		color: var(--foreground);
	}

	.case-subtitle {
		font-size: 1.1rem;
		color: var(--muted-foreground);
		margin: 0.5rem 0 0;
	}

	.case-meta {
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
		margin-bottom: 3rem;
	}

	.meta-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
	}

	.meta-label {
		font-size: 0.82rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted-foreground);
		margin: 0 0 0.5rem;
	}

	.meta-value {
		font-size: 1.1rem;
		color: var(--foreground);
		margin: 0;
	}

	.case-section {
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.case-section h2 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
		color: var(--foreground);
	}

	.case-section p,
	.case-section li {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--foreground);
		margin: 0.5rem 0;
	}

	.case-section ul {
		margin: 1rem 0;
		padding-left: 1.5rem;
	}

	.case-footer {
		padding: 2rem 0;
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.case-header {
			padding: 2rem 0;
		}

		.case-header h1 {
			font-size: 1.8rem;
		}

		.case-section {
			padding: 1.5rem 0;
		}
	}
</style>
