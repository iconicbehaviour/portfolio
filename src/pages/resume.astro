---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import figmaLogo from '../assets/logos/figma.svg';
import framerLogo from '../assets/logos/framer.svg';
import shopifyLogo from '../assets/logos/shopify.svg';
import webflowLogo from '../assets/logos/webflow.svg';

const tools = [
	{ name: 'Figma', logo: figmaLogo, tone: 'light' },
	{ name: 'Framer', logo: framerLogo, tone: 'dark' },
	{ name: 'Notion', logo: shopifyLogo, tone: 'light' },
	{ name: 'Linear', logo: webflowLogo, tone: 'light' },
];
---

<Layout
	title="Resume | Niranjana - Product Manager"
	description="Resume showcasing product management experience, expertise in product strategy, cross-functional leadership, and building products that drive impact."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">Building products that create real impact and solve meaningful problems.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						I combine strategic thinking with hands-on execution to drive product success.
						My work spans product strategy, roadmap prioritization, cross-functional leadership,
						and shipping products that users love.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Snapshot</p>
				</div>
				<div class="story-block">
					<p><strong>Location:</strong> New York</p>
					<p><strong>Focus:</strong> Product Management / Product Strategy</p>
					<p><strong>Specialties:</strong> Product strategy, user research, cross-functional leadership</p>
					<p><strong>Contact:</strong> <a href="mailto:nn2772@nyu.edu">nn2772@nyu.edu</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Product Manager</strong><br />
						NyanTrace, January - June 2026
					</p>
					<p>
						Drove product strategy and execution. Collaborated with cross-functional teams to ship features
						and improvements. Conducted user research and data analysis to inform product decisions.
					</p>
					<p>
						<strong>Product Manager</strong><br />
						PWC, September - December 2025
					</p>
					<p>
						Managed product roadmap and prioritization. Worked with engineering and design to deliver
						high-impact features. Conducted user interviews and defined success metrics.
					</p>
					<p>
						<strong>Product Manager</strong><br />
						Method
					</p>
					<p>
						Led product initiatives and cross-functional collaboration. Focused on user-centered design
						and data-driven decision making.
					</p>
					<p>
						<strong>Product Manager</strong><br />
						Inflection.io
					</p>
					<p>
						Contributed to product strategy and execution. Worked on product features and user experience improvements.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Capabilities</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Product Strategy:</strong> defining product vision, roadmap prioritization,
						and aligning teams around shared goals and metrics.
					</p>
					<p>
						<strong>User Research:</strong> conducting interviews, analyzing user behavior, and
						translating insights into product requirements.
					</p>
					<p>
						<strong>Software Engineering:</strong> understanding technical constraints, evaluating
						architectural decisions, and collaborating effectively with engineering teams.
					</p>
					<p>
						<strong>Cross-functional Leadership:</strong> collaborating with design, engineering,
						marketing, and leadership to ship products successfully.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Tools</p>
				</div>
				<div class="tools-grid">
					{
						tools.map((tool) => (
							<div class="tool-card">
								<div class:list={['tool-mark', tool.tone === 'dark' && 'tool-mark-dark']} aria-hidden="true">
									<Image class="tool-logo" src={tool.logo} alt="" loading="lazy" />
								</div>
								<p class="tool-name">{tool.name}</p>
							</div>
						))
					}
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 44rem;
	}

	.tool-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: 1.15rem;
		background: var(--card);
	}

	.tool-mark {
		width: 3rem;
		height: 3rem;
		flex: 0 0 3rem;
		display: grid;
		place-items: center;
		border-radius: 0.9rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--muted) 90%, var(--card) 10%) 0%,
			color-mix(in srgb, var(--border) 55%, var(--card) 45%) 100%
		);
		border: 1px solid color-mix(in srgb, var(--border) 88%, var(--background) 12%);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.tool-mark-dark {
		background: #111111;
		border-color: #111111;
	}

	.tool-logo {
		width: 1.55rem;
		height: 1.55rem;
		display: block;
		object-fit: contain;
	}

	.tool-name {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
