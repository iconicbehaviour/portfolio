---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import portraitImage from '../assets/images/maria.webp';
---

<Layout
	title="About Niranjana | Product Manager"
	description="Product manager passionate about building products that solve real problems and drive meaningful impact."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">About</p>
				<div class="hero-layout">
					<div class="hero-copy">
						<h1 class="display-title">I build products that solve real problems and create meaningful impact.</h1>
						<p class="hero-text">
							I'm Niranjana, a Product Manager driven by the goal of creating products users love.
							I combine strategic thinking with hands-on execution to guide products from vision
							through launch—and beyond.
						</p>
					</div>
					<div class="hero-portrait-wrap">
						<Image
							class="hero-portrait"
							src={portraitImage}
							alt="Portrait of Niranjana"
							loading="eager"
							decoding="async"
							widths={[320, 480, 640]}
							sizes="(max-width: 980px) 100vw, 32vw"
						/>
					</div>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Background</p>
				</div>
				<div class="story-block">
					<p>
						I've built products and led cross-functional teams at companies including PWC, NyanTrace, Method,
						and Inflection.io. Across these experiences, I've developed a deep conviction that great products come
						from truly understanding user needs and aligning teams around a clear vision.
					</p>
					<p>
						I believe the best product managers sit at the intersection of strategy, design, and engineering.
						I'm comfortable in the details—diving into data, conducting user research, and working through technical constraints—
						while also maintaining sight of the bigger picture.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">How I Work</p>
				</div>
				<div class="story-block">
					<p>
						I start by deeply understanding the problem. That means talking to users, analyzing data,
						and working closely with design and engineering to define what success looks like.
					</p>
					<p>
						I thrive in collaborative environments where we challenge assumptions, make data-driven decisions,
						and ship iteratively. I'm comfortable wearing multiple hats—from strategy and research to execution
						and metrics tracking.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Focus</p>
				</div>
				<div class="story-block">
					<p>
						I'm passionate about building products that are intuitive, scalable, and user-centric.
						I'm particularly interested in B2B SaaS, fintech, and products where attention to detail
						creates measurable business impact.
					</p>
					<p>
						Right now, I'm focused on understanding how AI and emerging technologies can be integrated
						thoughtfully into products to genuinely improve user experience—not just for novelty's sake.
					</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 20rem);
		gap: 2.5rem;
		align-items: start;
		margin-top: 1rem;
	}

	.hero-copy {
		max-width: 52rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.hero-text {
		max-width: 44rem;
		margin-top: 1.5rem;
	}

	.hero-portrait-wrap {
		display: flex;
		justify-content: flex-end;
		align-self: start;
		padding-top: 0.35rem;
	}

	.hero-portrait {
		width: min(100%, 20rem);
		height: auto;
		display: block;
		border-radius: 1.5rem;
		box-shadow: 0 18px 40px rgba(23, 23, 23, 0.08);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	@media (max-width: 1100px) {
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			align-items: start;
		}

		.hero-copy {
			max-width: 100%;
		}

		.hero-text {
			max-width: 42rem;
		}

		.hero-portrait-wrap {
			justify-content: flex-start;
			padding-top: 0;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.hero-portrait {
			width: min(100%, 16rem);
		}
	}
</style>
